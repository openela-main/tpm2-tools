+#include <endian.h>
 
 #include <tss2/tss2_tpm2_types.h>
 
@@ -42,7 +43,7 @@
 static void guid_unparse_lower(EFI_GUID guid, char guid_buf[37]) {
 
     snprintf(guid_buf, 37, "%08x-%04x-%04x-%02x%02x-%02x%02x%02x%02x%02x%02x",
